# Supabase → Project Settings → API. Leave empty to run in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: shown on the Terms / Privacy / Guidelines pages as the contact for questions and complaints.
NEXT_PUBLIC_CONTACT_EMAIL=

# Phone notifications (see README → Phone notifications). Leave empty to hide the feature.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_CRON_SECRET=
