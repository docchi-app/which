# Supabase → Project Settings → API. Leave empty to run in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Google sign-in on this domain, so Google's screen names the site instead of Supabase
# (see README → Google sign-in). Same OAuth client as in Supabase. The secret is server-only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: shown on the Terms / Privacy / Guidelines pages as the contact for questions and complaints.
NEXT_PUBLIC_CONTACT_EMAIL=

# Phone notifications (see README → Phone notifications). Leave empty to hide the feature.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_CRON_SECRET=

# Quick snap safety check (OpenAI moderation, free). Server-only; mark Sensitive in Vercel.
OPENAI_API_KEY=
